<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The font-measurement helpers behind text editing (#29) are pure functions with edge cases
         — unusable font metrics, subset name tags — that are far cheaper to pin down directly than
         to reach through a hand-built PDF for each one. They stay internal: this widens the test
         project's reach, not the public API. -->
    <InternalsVisibleTo Include="PdfEditor.Core.Tests" />
    <!-- The other test projects build their fixtures with the engine directly rather than with a
         second PDF library, so they need the same view of it. -->
    <InternalsVisibleTo Include="PdfEditor.IntegrationTests" />
    <InternalsVisibleTo Include="PdfEditor.NativeHost.Tests" />
    <InternalsVisibleTo Include="PdfEditor.Perf.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Adobe's Core 14 font metrics and glyph lists, used to measure and decode text in the
         standard fonts. Distributed unmodified, with Adobe's MustRead.html as its licence requires. -->
    <EmbeddedResource Include="Pdf/Fonts/Resources/**/*" LogicalName="PdfEditor.Core.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
    <!-- CMS (PKCS#7) signing and PKCS#12 building for digital signatures; Microsoft, MIT. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.1" />
  </ItemGroup>

</Project>
